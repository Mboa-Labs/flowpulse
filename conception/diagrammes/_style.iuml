' Style commun FlowPulse
!pragma layout smetana
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #44546A
skinparam ArrowThickness 1.2
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #C9A227
skinparam packageBorderColor #7F8C8D
skinparam rectangleBorderColor #44546A
skinparam componentBorderColor #44546A
skinparam componentBackgroundColor #F4F8FB
skinparam databaseBackgroundColor #EAF2F8
skinparam classBackgroundColor #F8FBFD
skinparam classBorderColor #44546A
skinparam classHeaderBackgroundColor #DCEBF5
skinparam actorBorderColor #44546A
skinparam actorBackgroundColor #FDEBD0
skinparam usecaseBackgroundColor #F4F8FB
skinparam usecaseBorderColor #44546A
skinparam sequenceLifeLineBorderColor #7F8C8D
skinparam sequenceParticipantBackgroundColor #F4F8FB
skinparam sequenceParticipantBorderColor #44546A
skinparam activityBackgroundColor #F4F8FB
skinparam activityBorderColor #44546A
skinparam activityDiamondBackgroundColor #FDEBD0
skinparam stateBackgroundColor #F4F8FB
skinparam stateBorderColor #44546A
skinparam nodeBackgroundColor #F8FBFD
