# Copier en .env et adapter. Le fichier .env n'est pas versionné.
DB_USER=flowpulse
DB_PASSWORD=flowpulse
JWT_SECRET=remplacer-par-une-cle-aleatoire-d-au-moins-32-caracteres
ADMIN_EMAIL=admin@flowpulse.local
ADMIN_PASSWORD=remplacer-ce-mot-de-passe

# Comptes de démonstration (gestionnaire, operateur, urbaniste @flowpulse.local) pour les tests
DEMO_USERS=true
DEMO_PASSWORD=demo1234

# Modèle de langage : Ollama installé sur la machine hôte (recommandé sur Mac)
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b

# Port de l'application sur la machine hôte
APP_PORT=8081
